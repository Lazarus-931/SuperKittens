// One threadgroup per output element. 32 threads = 1 simdgroup.
kernel void gemm_iq2xxs_mv(
        constant iq2xxs_mv_args & args        [[buffer(0)]],
        device   const half     * x           [[buffer(1)]],   // [D]
        device   const char     * W           [[buffer(2)]],   // [N] rows of nb blocks
        device         half     * y           [[buffer(3)]],   // [N]
        uint   tgpig  [[threadgroup_position_in_grid]],
        ushort tiisg  [[thread_index_in_simdgroup]])
{
    const uint D = args.D;
    const uint n_row = tgpig;       // output row
    const uint nb = D / QK_K;       // blocks per row
    const uint nb32 = nb * (QK_K / 32);  // 32-weight sub-blocks per row

    device const block_iq2_xxs * row = (device const block_iq2_xxs *)(W)
                                       + (uint64_t)n_row * nb;

    float sumf = 0.f;

    // Each lane handles sub-blocks with stride 32.
    for (uint ib32 = tiisg; ib32 < nb32; ib32 += 32) {
        const uint ibl = ib32 / 8;          // which block
        const uint ib  = ib32 & 7;          // sub-block within block

        device const block_iq2_xxs * xr = row + ibl;
        device const uint16_t * q2 = xr->qs + 4 * ib;
        const float db = (float)xr->d;

        // 32 activations for this sub-block
        device const half * y4 = x + (uint64_t)ib32 * 32;

        device const uchar * aux8 = (device const uchar *)q2;
        const uint32_t aux32 = (uint32_t)q2[2] | ((uint32_t)q2[3] << 16);
        const float d = db * (0.5f + (float)(aux32 >> 28));

        float sum = 0.f;
        for (short l = 0; l < 4; ++l) {
            constant uchar * grid = (constant uchar *)(iq2xxs_grid + aux8[l]);
            const uchar signs = ksigns_iq2xs[(aux32 >> (7 * l)) & 127];
            for (short j = 0; j < 8; ++j) {
                const float s = (signs & kmask_iq2xs[j]) ? -1.f : 1.f;
                sum += (float)y4[8 * l + j] * (float)grid[j] * s;
            }
        }
        sumf += d * sum;
    }

    // Reduce across simdgroup; apply 0.25 super-scale factor.
    const float total = simd_sum(sumf) * 0.25f;
    if (tiisg == 0) {
        y[n_row] = (half)total;
    }
}
